# Copy this file to `.env.local` and adjust for your environment.

# Base URL of the RCP API gateway (all /api/* routes + /.well-known)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional WebSocket endpoint for instant force logout events.
# Defaults to the API base URL converted to ws/wss and /ws if omitted.
NEXT_PUBLIC_RTO_WS_URL=ws://localhost:8080/ws
